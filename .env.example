# Environment variables template — copy ke .env.local lalu isi
NEXT_PUBLIC_RECIPIENT_NAME="Nama Penerima"
NEXT_PUBLIC_SENDER_NAME="Nama Pengirim"

# Path file musik di folder public/music/ (kosongkan jika tidak pakai musik)
NEXT_PUBLIC_MUSIC_FILE="/music/birthday.mp3"

# Mulai musik dari detik ke-berapa. Contoh: 90 = menit 1:30, 0 = dari awal
NEXT_PUBLIC_MUSIC_START_TIME=0
